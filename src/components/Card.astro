---
interface Props {
  href: string;
  title: string;
  thumbnail?: string;
}

const { href, title, thumbnail } = Astro.props;
---

<article
  class="relative bg-surface-glass-light dark:bg-surface-glass border border-border-glass-light dark:border-border-glass rounded-lg p-6 hover:-translate-y-1 hover:shadow-lg transition-all flex flex-col sm:flex-row sm:items-center gap-6"
>
  {
    thumbnail && (
      <div class="w-full sm:w-1/3 shrink-0">
        <img
          src={thumbnail}
          alt=""
          class="w-full aspect-video object-cover rounded-md"
        />
      </div>
    )
  }
  <div class="flex-1 w-full min-w-0">
    <h3 class="text-xl font-bold mb-2">
      <a
        href={href}
        class="hover:text-primary dark:hover:text-accent after:absolute after:inset-0"
      >
        {title}
      </a>
    </h3>
    <div class="relative z-10">
      <slot />
    </div>
  </div>
</article>
