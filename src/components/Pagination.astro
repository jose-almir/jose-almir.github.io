---
import { useTranslations } from "../i18n";

interface Props {
  lang: string;
  prevUrl?: string;
  nextUrl?: string;
}

const { lang, prevUrl, nextUrl } = Astro.props;
const t = useTranslations(lang as "pt" | "en");
---

{
  (prevUrl || nextUrl) && (
    <nav class="flex items-center justify-between mt-12 pt-6 border-t border-border-glass-light dark:border-border-glass">
      <div>
        {prevUrl && (
          <a
            href={prevUrl}
            class="flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-primary dark:hover:text-accent font-medium transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
            {t("nav.prev_page")}
          </a>
        )}
      </div>
      <div>
        {nextUrl && (
          <a
            href={nextUrl}
            class="flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-primary dark:hover:text-accent font-medium transition-colors"
          >
            {t("nav.next_page")}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>
        )}
      </div>
    </nav>
  )
}
